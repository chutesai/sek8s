[Unit]
Description=Configure nvidia-persistenced ExecStart based on NVSwitch topology
Documentation=man:nvidia-smi(1)
# Wait for udev to settle and the nvidia device to appear
# Device is tagged with systemd in 99-nvidia-systemd.rules (with SYMLINK for proper device unit creation)
After=systemd-udev-settle.service
BindsTo=dev-nvidia0.device
RequiresMountsFor=/tmp
Before=nvidia-persistenced.service nvidia-fabricmanager.service
# This service is critical - device must be present
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
# Add a small delay to ensure NVSwitch devices are also enumerated after nvidia0
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/sbin/nvidia-persistenced-config.sh
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target sysinit.target
