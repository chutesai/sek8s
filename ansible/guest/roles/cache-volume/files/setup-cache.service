[Unit]
Description=Set up HF cache dir for pod use
Documentation=man:systemd.service(5)
Requires=var-snap.mount
After=var-snap.mount
After=verify-cache-volume.service
Before=k3s.service
# Without the HF cache we don't have enough room for model weights; shut down on failure
OnFailure=poweroff.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/setup-cache.sh
RemainAfterExit=yes
# This unit powers the VM off when it fails, and its output went to the journal only -- which
# dies with the VM on a production image (no SSH, and the root LUKS passphrase is rotated at
# first boot, so the journal cannot be read back offline either). Its siblings
# verify-cache-volume, setup-storage-bind-mounts and infiniband-config all already do this.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
