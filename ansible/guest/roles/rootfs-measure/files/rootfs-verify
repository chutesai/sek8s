#!/usr/bin/env python3
# /usr/local/bin/rootfs-verify
#
# Post-mount root filesystem integrity check: against hardware RTMR3 on TDX, against
# the list the initramfs verified on SEV-SNP.
#
# Runs once at boot after setup-storage-bind-mounts.service (and therefore
# after rsync -ac has synced root manifests into the storage volume).
# Recomputes the full RTMR3 SHA-384 extension chain from the paths listed in
# /etc/tee-measure.conf and compares the result to the live hardware RTMR3
# obtained from a freshly generated TDX attestation quote.
#
# At this point bind-mounts are active, so any path that is backed by the
# storage volume (e.g. /var/lib/rancher/k3s/server/manifests) is read from
# storage.  The init-bottom script extended RTMR3 using the ROOT versions of
# those paths.  Because rsync -ac always overwrites storage with root content,
# the two hash chains should be identical.  Any divergence — whether from an
# offline tamper that rsync missed, a sync regression, or a runtime
# modification — produces a chain mismatch that powers off the VM.
#
# This script is measured in RTMR3 itself (see tee-measure-miner.conf), so it
# cannot be modified at runtime without the hardware RTMR3 reflecting that
# change — making any tampered version self-defeating.
#
# RTMR3 (mirrors init-bottom rootfs-measure):
#   rtmr3 = SHA384(0x00...0 || SHA384(tee-measure hash output))
# One extend over a digest of the whole ordered "<sha384hex> <path>" list, not one per file.
#
# WHICH files are measured, in WHAT ORDER, and HOW each one is hashed are NOT
# decided here: they come from /usr/local/bin/tee-measure, the same script the
# initramfs measurer runs at boot and the build-time manifest generator runs over
# the image.  Re-deriving any of that here is exactly what let four independent
# walkers of tee-measure.conf disagree four ways.  This script owns only the chain
# fold and the comparison against hardware.
#
# The helper is loaded from /usr/local/lib/sek8s (RTMR3-measured, like this script)
# rather than imported from the sek8s package: this runs on the SYSTEM interpreter,
# ordered before k3s, and must not resolve through /opt/sek8s/venv, which is
# outside the measured-path list.
#
# Hardware RTMR3 is read from a fresh TDX attestation quote (primary) or the
# tsm-mr sysfs attribute (fallback for kernels that expose it as readable).
# Any unrecoverable error also triggers a forced poweroff.
#
# The platform gate mirrors the initramfs rootfs-measure exactly. A TDX guest is
# verified against hardware RTMR3. An SEV-SNP guest has no RTMR3: there the
# initramfs checked the root against the canonical manifest and left the verified
# list digest in /run (tmpfs, written only by the measured initramfs), and this
# compares the post-bind-mount list against that instead. A guest with neither
# device is not a confidential VM and fails closed.

import os
import subprocess
import sys
import tempfile
from pathlib import Path

# Before the import, not after: /usr/local/lib is RTMR3-measured, so a __pycache__
# written next to the module would change the measured tree and power the VM off on
# the NEXT boot. The unit sets PYTHONDONTWRITEBYTECODE too; this covers manual runs.
sys.dont_write_bytecode = True
sys.path.insert(0, "/usr/local/lib/sek8s")
from rtmr3 import Rtmr3Error, compute_rtmr3, list_digest, measured_hashes  # noqa: E402

TDX_GUEST_DEVICE = Path("/dev/tdx_guest")
SEV_GUEST_DEVICE = Path("/dev/sev-guest")
CONF             = Path("/etc/tee-measure.conf")
SYSFS_RTMR3      = "/sys/class/misc/tdx_guest/measurements/rtmr3:sha384"
SNP_VERIFIED     = Path("/run/sek8s/rootfs-digest")
QUOTE_GENERATOR  = Path("/usr/bin/tdx-quote-generator")
QUOTE_RTMR3_OFF  = 520
QUOTE_RTMR3_LEN  = 48
POWEROFF_DELAY   = 10

# When true: log warnings instead of powering off on any failure or mismatch.
# Set via RTMR3_VERIFY_DEBUG_MODE=true in /etc/default/rootfs-verify (debug builds only).
DEBUG_MODE = os.environ.get("RTMR3_VERIFY_DEBUG_MODE", "false").lower() == "true"


# ── helpers ─────────────────────────────────────────────────────────────────

def _kmsg(msg: str) -> None:
    try:
        with open("/dev/kmsg", "w") as fh:
            fh.write(f"rootfs-verify: {msg}\n")
    except OSError:
        pass


def fatal(msg: str) -> None:
    if DEBUG_MODE:
        print(f"rootfs-verify: WARNING (debug mode — would poweroff): {msg}", file=sys.stderr)
        _kmsg(f"WARNING (debug mode): {msg}")
        return
    print(f"rootfs-verify: FATAL: {msg}", file=sys.stderr)
    _kmsg(f"FATAL: {msg}")
    print(
        f"rootfs-verify: powering off in {POWEROFF_DELAY} seconds",
        file=sys.stderr,
    )
    sys.stderr.flush()
    import time
    time.sleep(POWEROFF_DELAY)
    os.system("systemctl poweroff --force")
    sys.exit(1)


# ── platform ─────────────────────────────────────────────────────────────────

def platform() -> str | None:
    """``"tdx"`` or ``"snp"``. Same decision as initramfs rootfs-measure."""
    if TDX_GUEST_DEVICE.is_char_device():
        return "tdx"
    if SEV_GUEST_DEVICE.is_char_device():
        return "snp"
    fatal(f"TDX device ({TDX_GUEST_DEVICE}) not available — not running in a TDX guest")
    return None  # reached only in debug mode, where fatal() warns instead of powering off


def verify_snp() -> None:
    """The live root, post-bind-mount, against the list the initramfs verified at boot."""
    try:
        recorded = SNP_VERIFIED.read_text().strip()
    except OSError:
        fatal(f"SEV-SNP: {SNP_VERIFIED} missing — the initramfs did not verify the root")
        return
    try:
        files = measured_hashes("", CONF)
    except Rtmr3Error as exc:
        fatal(str(exc))
        return
    if list_digest(files) == recorded:
        print(f"rootfs-verify: PASS — SEV-SNP root matches the boot-verified list ({len(files)} files)")
        _kmsg(f"PASS — SEV-SNP root matches the boot-verified list ({len(files)} files)")
        return
    _kmsg(f"SEV-SNP list MISMATCH: live={list_digest(files)} boot={recorded}")
    fatal("SEV-SNP: storage or runtime tampering detected — the root differs from the list verified at boot")


# ── measurement ──────────────────────────────────────────────────────────────

def measure() -> tuple[bytes, list[tuple[str, str]]]:
    """Return (expected RTMR3, per-file (sha384hex, path)).

    Both the file set and the per-file hashes come from tee-measure; the fold is
    `rtmr3 = SHA384(0^48 || SHA384(list))`, the single value the initramfs extends.
    Root is "" because this verifies the live filesystem, post-bind-mount.
    """
    try:
        expected_hex, files = compute_rtmr3("", CONF)
    except Rtmr3Error as exc:
        fatal(str(exc))
    return bytes.fromhex(expected_hex), files


# ── hardware RTMR3 read ──────────────────────────────────────────────────────

def _read_rtmr3_sysfs() -> bytes | None:
    """
    Try reading RTMR3 directly from the tsm-mr sysfs attribute (Linux 6.16+).
    Returns 48 bytes on success, None if the file is not readable.
    """
    try:
        with open(SYSFS_RTMR3, "rb") as fh:
            data = fh.read(QUOTE_RTMR3_LEN)
        if len(data) == QUOTE_RTMR3_LEN:
            return data
    except OSError:
        pass
    return None


def _read_rtmr3_quote() -> bytes | None:
    """
    Generate a fresh TDX attestation quote and parse RTMR3 from it.
    Returns 48 bytes on success, None on failure.
    """
    if not QUOTE_GENERATOR.exists():
        return None
    with tempfile.NamedTemporaryFile(suffix=".bin", delete=False) as tf:
        quote_path = tf.name
    try:
        result = subprocess.run(
            [str(QUOTE_GENERATOR), "--output", quote_path],
            capture_output=True,
            timeout=30,
        )
        if result.returncode != 0:
            print(
                f"rootfs-verify: tdx-quote-generator error: "
                f"{result.stderr.decode(errors='replace').strip()}",
                file=sys.stderr,
            )
            return None
        quote = Path(quote_path).read_bytes()
        if len(quote) < QUOTE_RTMR3_OFF + QUOTE_RTMR3_LEN:
            print(
                f"rootfs-verify: quote too short ({len(quote)} bytes)",
                file=sys.stderr,
            )
            return None
        return quote[QUOTE_RTMR3_OFF : QUOTE_RTMR3_OFF + QUOTE_RTMR3_LEN]
    finally:
        try:
            os.unlink(quote_path)
        except OSError:
            pass


def read_hardware_rtmr3() -> bytes:
    """Return the live 48-byte RTMR3 value from the TDX hardware."""
    val = _read_rtmr3_sysfs()
    if val is not None:
        return val
    val = _read_rtmr3_quote()
    if val is not None:
        return val
    fatal(
        f"cannot read hardware RTMR3: sysfs unavailable and "
        f"{QUOTE_GENERATOR} not found or failed"
    )


# ── main ─────────────────────────────────────────────────────────────────────

def verify_tdx() -> None:
    """The live root, post-bind-mount, against hardware RTMR3."""
    print("rootfs-verify: measuring via tee-measure ...")
    expected, files = measure()
    print(f"rootfs-verify: measured {len(files)} files")

    print("rootfs-verify: reading hardware RTMR3 ...")
    hardware = read_hardware_rtmr3()

    if expected == hardware:
        print(
            f"rootfs-verify: PASS — RTMR3 verified "
            f"({len(files)} files, {expected.hex()[:16]}...)"
        )
        _kmsg(f"PASS — RTMR3 verified ({len(files)} files)")
        return

    # Mismatch: log details then fatal (poweroff in production, warn in debug).
    _kmsg(
        f"RTMR3 MISMATCH: computed={expected.hex()} hardware={hardware.hex()}"
    )
    label = "WARNING (debug mode)" if DEBUG_MODE else "FAIL"
    print(f"rootfs-verify: {label} — RTMR3 mismatch", file=sys.stderr)
    print(f"  computed: {expected.hex()}", file=sys.stderr)
    print(f"  hardware: {hardware.hex()}", file=sys.stderr)
    print("\nrootfs-verify: per-file hashes (current filesystem):", file=sys.stderr)
    for digest, path in files:
        print(f"  {digest}  {path}", file=sys.stderr)
    fatal("storage or runtime tampering detected — RTMR3 does not match expected value")


def main() -> None:
    tee = platform()
    if tee is not None:  # None only in debug mode, where fatal() warned instead of powering off
        {"tdx": verify_tdx, "snp": verify_snp}[tee]()
    sys.exit(0)


if __name__ == "__main__":
    main()
