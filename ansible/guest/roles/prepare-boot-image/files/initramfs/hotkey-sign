# /etc/initramfs-tools/scripts/hotkey-sign
#
# Miner-hotkey proof-of-possession for the boot attestation / provision flow, sourced by the
# boot-lifecycle initramfs scripts (init-premount-common, init-bottom-common).
#
# The Python substrate stack cannot run in a busybox initramfs, so signing uses the
# staged static /usr/bin/sr25519 (Schnorr/Ristretto, byte-compatible with substrate-interface).
# The proof is an sr25519 signature over  {ss58}:{nonce}:{sha256(body)}  where {nonce} is the
# server-issued single-use nonce each call is chained (each API response hands the next call its
# nonce, also sent verbatim in X-Chutes-Nonce), and {sha256(body)} is the hex sha256 of the exact
# request body. Sent in X-Chutes-Signature alongside X-Chutes-Hotkey. The API reconstructs the same
# message (get_signing_message with the body hash it computed over the received bytes; verify_hotkey_auth)
# and verifies it against the hotkey, so a caller cannot assert another miner's (hotkey, vm_name)
# and rotate its LUKS passphrase.
#
# Staged UNCONDITIONALLY (prod + debug): the hotkey identity is proven on every boot. The key
# arrives at runtime on the per-VM config volume as miner-seed or miner-private-key (the 64-byte
# sr25519 private key, the current hotkey file format), never both: chutes-cvm refuses to launch
# with both, and a volume carrying both fails here rather than after attestation. The key is stashed to the initramfs /run tmpfs (while the
# volume is mounted, in init-premount) and shredded before pivot_root. Signing picks the key and
# derives the ss58 from the STASHED FILE each call — not a shell var — because init-premount and
# init-bottom are separate script invocations and only the /run file persists.

HOTKEY_SEED="/run/chutes/miner-seed"
HOTKEY_PRIVATE_KEY="/run/chutes/miner-private-key"

# hotkey_stash_key <config_mount>
#   Copy the miner key off the (currently mounted) config volume into the initramfs /run tmpfs.
#   Called in init-premount while the config volume is still mounted. Returns 1 unless exactly one
#   key file exists and it derives a valid hotkey.
hotkey_stash_key() {
    if [ -f "$1/miner-private-key" ] && [ -f "$1/miner-seed" ]; then
        return 1
    elif [ -f "$1/miner-private-key" ]; then
        _hk_src="$1/miner-private-key" _hk_dst="$HOTKEY_PRIVATE_KEY"
    elif [ -f "$1/miner-seed" ]; then
        _hk_src="$1/miner-seed" _hk_dst="$HOTKEY_SEED"
    else
        return 1
    fi
    mkdir -m 0700 -p "${_hk_dst%/*}"
    cp "$_hk_src" "$_hk_dst"
    chmod 600 "$_hk_dst"
    [ -n "$(hotkey_ss58)" ] || return 1
    return 0
}

# _hotkey_sr25519 <verb> [args...]
#   Run sr25519 with the stashed key's flag. Returns 1 when no key was stashed.
_hotkey_sr25519() {
    _hk_verb="$1"
    shift
    if [ -f "$HOTKEY_PRIVATE_KEY" ]; then
        sr25519 "$_hk_verb" --private-key-file "$HOTKEY_PRIVATE_KEY" "$@"
    elif [ -f "$HOTKEY_SEED" ]; then
        sr25519 "$_hk_verb" --seed-file "$HOTKEY_SEED" "$@"
    else
        return 1
    fi
}

# hotkey_ss58
#   Echo the AUTHORITATIVE ss58 derived from the stashed key. Works in any later init-bottom
#   script (the key file persists on /run tmpfs; shell globals do not). Deriving from the key
#   rather than trusting the config's miner-ss58 is the point — it proves possession, and closes
#   the footgun where a typo'd miner-ss58 attests under a hotkey every allow_miner route rejects.
hotkey_ss58() {
    _hotkey_sr25519 address 2>/dev/null
}

# hotkey_sign <nonce> <body>
#   Echo a hex sr25519 signature over  {ss58}:{nonce}:{sha256hex(body)}  — the exact message the API
#   reconstructs (get_signing_message with payload_hash = request.state.body_sha256, hashed over the
#   received body bytes; verify_hotkey_auth). {nonce} must be the call's server-issued nonce, also
#   sent verbatim in X-Chutes-Nonce. {body} must be byte-identical to the curl -d payload. Echoes
#   nothing when no key was stashed. sr25519 emits hex, decoded API-side with bytes.fromhex().
hotkey_sign() {
    _hk_ss58=$(hotkey_ss58) || return 0
    [ -n "$_hk_ss58" ] || return 0
    _hk_bh=$(printf '%s' "$2" | sha256sum | cut -d' ' -f1)
    _hotkey_sr25519 sign --message "${_hk_ss58}:${1}:${_hk_bh}" 2>/dev/null
}

# hotkey_shred_key
#   Remove the stashed key. Called before pivot_root so the initramfs copy never reaches userspace.
hotkey_shred_key() {
    rm -f "$HOTKEY_SEED" "$HOTKEY_PRIVATE_KEY"
}
