# vim: ft=apparmor
# sek8s.setup-cache — AppArmor profile for setup-cache.sh.
# Applied via systemd AppArmorProfile= directive (not auto-attached).
# Grants: cache rw, coreutils. No network, no credentials.

abi <abi/4.0>,

include <tunables/global>

profile sek8s.setup-cache flags=(enforce) {
  include <abstractions/base>

  # chown -R / chmod 2775 on the cache tree (owned 1000:1000, not root)
  capability chown,
  capability fowner,
  capability fsetid,
  # The recursive chown above hands the cache dir to uid 1000 (mode 2775 -- no write for other),
  # and the script then mkdirs .xdg-cache inside it as root. That needs DAC_OVERRIDE, and
  # AppArmor mediates capability use per profile, so the kernel granting it to root is not
  # enough. Only bites on an enforcing build with an empty cache: where .xdg-cache already
  # exists `mkdir -p` is a no-op and never needs the write. Bounded by this profile's file
  # rules to the cache tree. sek8s system-manager already carries CAP_DAC_OVERRIDE for the
  # same reason (unlinking pod-owned files under the same directory).
  capability dac_override,

  # The script and its interpreter
  /usr/local/bin/setup-cache.sh r,
  /usr/bin/bash mrix,
  /bin/sh mrix,

  # Cache volume — create dirs and set ownership
  /var/snap/ r,
  /var/snap/cache/ rw,
  /var/snap/cache/** rwlk,

  # Coreutils used by the script
  /usr/bin/mkdir mrix,
  /usr/bin/chown mrix,
  /usr/bin/chmod mrix,
  /usr/bin/mountpoint mrix,
  /usr/bin/logger mrix,
  /usr/bin/sync mrix,
  /usr/bin/echo mrix,
  /sbin/shutdown mrix,

  # System libraries
  /usr/lib/** rm,
  /etc/ld.so.cache r,
  /etc/ld.so.conf r,
  /etc/ld.so.conf.d/** r,

  # Proc (mountpoint check)
  @{PROC}/** r,

  # Logging (logger uses journal socket)
  /dev/log w,
  /run/systemd/journal/socket w,
  /run/systemd/journal/dev-log w,
  /dev/null rw,

  network unix dgram,
}
